{
  "name": "proxima",
  "version": "0.1.0",
  "description": "Proxima (\"Proxy\") — Jarvis-style Windows desktop assistant",
  "private": true,
  "main": "dist/electron/main.js",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "ts-node src/core/assistant.ts",
    "dashboard": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win nsis",
    "setup:cv": "node scripts/download-hand-model.js",
    "setup:whisper": "node scripts/setup-whisper.js",
    "setup:gmail": "node scripts/gmail-auth.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0",
    "@picovoice/pvrecorder-node": "^1.2.0",
    "dotenv": "^16.4.5",
    "googleapis": "^176.0.0",
    "ollama": "^0.5.9",
    "playwright-core": "^1.62.1"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "@types/node": "^20.14.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "extract-zip": "^2.0.1",
    "three": "^0.185.1",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.16",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "com.proxima.desktop",
    "productName": "Proxima",
    "directories": {
      "output": "installer"
    },
    "files": [
      "dist/**/*",
      "package.json",
      "README.md"
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Proxima"
    }
  }
}
